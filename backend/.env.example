# Copiar a .env y completar. En la nube, cargar estas variables en el panel del servicio.

# "produccion" activa controles de arranque: el servidor NO levanta si JWT_SECRET/PROVISIONING_KEY
# son los de fábrica o tienen menos de 32 caracteres, si son iguales entre sí, o si no hay forma de mandar push.
ENTORNO=desarrollo
DATABASE_URL=mysql+pymysql://usuario:clave@host:3306/eloy?charset=utf8mb4
# O en partes, como la pasa una base administrada (si está DATABASE_URL, manda esa). En Northflank son alias
# de las variables del addon: HOST, PORT, DATABASE, USERNAME, PASSWORD y TLS_ENABLED.
# DB_HOST=primary.eloy-db--xxxx.addon.code.run
# DB_PORT=3306
# DB_NAME=eloy
# DB_USER=...
# DB_PASSWORD=...
# DB_TLS=true                  (TLS verificando el certificado y el nombre del servidor)
# DB_TLS_CA=/ruta/ca.pem       (solo si la CA no es una de las del sistema)
JWT_SECRET=generar-con: python -c "import secrets; print(secrets.token_urlsafe(48))"
PROVISIONING_KEY=otra-clave-larga-solo-para-dar-de-alta-los-Eloy

# Push. Dos caminos que pueden convivir (cada token va por el suyo según cómo empieza):
#  - FCM directo (Android nativo): JSON de la cuenta de servicio de Firebase. Si la ruta está mal, el servidor no arranca.
#  - Servicio de Expo (iPhone con Expo): tokens "ExponentPushToken[...]". Activado por defecto.
FCM_CREDENCIALES=/secrets/firebase.json
PUSH_EXPO=true
# EXPO_ACCESS_TOKEN=            (solo si activaste la seguridad mejorada de push en tu proyecto de Expo)

# Alertas: qué pasa si un aviso falla o nadie atiende
# AVISO_VIGENCIA_MINUTOS=60    (pasado este tiempo desde que llegó la alerta, los avisos pendientes se descartan)
# REINTENTO_SEGUNDOS=15        (espera entre reintentos de un aviso que falló)
# REAVISO_MINUTOS=3            (si nadie la atiende, se vuelve a avisar cada tanto...)
# REAVISOS_MAXIMOS=10          (...hasta esta cantidad de veces)

# Detrás de un balanceador: IP o rango del balanceador cuyas cabeceras X-Forwarded-For se aceptan.
# NUNCA '*' (cualquiera podría falsear su IP y saltarse el límite de intentos). Por defecto: 127.0.0.1
# FORWARDED_ALLOW_IPS=10.0.0.0/8

# Audios: local (desarrollo) o s3
ALMACENAMIENTO=local
URL_PUBLICA=https://api.tu-dominio.com
# S3_BUCKET=eloy-audios
# S3_ENDPOINT_URL=https://<cuenta>.r2.cloudflarestorage.com   (solo si no es AWS)
# S3_REGION=auto
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

LINK_INVITACION=https://eloy.app/invitacion?codigo=
CORS_ORIGENES=[]
WORKER_ACTIVO=true
