# Copiar a .env (que no va a git) y reiniciar Expo con caché limpia: npx expo start -c
# Expo mete las EXPO_PUBLIC_* adentro de la app al compilar: nunca poner claves acá.

# Dirección del backend, sin / al final. La de Northflank está en backend/DEPLOY.md.
EXPO_PUBLIC_API_URL=https://http--eloy-api--8xm892fjxzwf.code.run

# true: los datos de ejemplo de src/api/simulado.ts, sin backend. false: el backend de arriba.
EXPO_PUBLIC_USAR_EJEMPLO=true
